# Server only. Copy to .env.local; never put the key in VITE_* or commit it.
HANLINGO_MODEL_BASE_URL=
HANLINGO_MODEL_API_KEY=
HANLINGO_MODEL=
# Optional distinct review model on the same provider.
HANLINGO_REVIEW_MODEL=
# Qwen hybrid models: set true to use JSON mode without thinking output.
HANLINGO_DISABLE_THINKING=
HANLINGO_API_HOST=127.0.0.1
HANLINGO_API_PORT=8788
HANLINGO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional public HTTPS API origin for a separately hosted backend.
# This is a URL, never a secret. Set before building the GitHub Pages frontend.
VITE_TRANSLATION_API_BASE=
